# Скопируйте этот файл в .env и подставьте свой ключ.
#   cp .env.example .env
#
# .env уже в .gitignore — ключ не попадёт в git.

# Ключ для OpenAI через прокси proxyapi.ru
OPENAI_API_KEY=вставьте_сюда_ваш_ключ

# (необязательно) можно переопределить базовый URL
# OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

# ─── База данных ───────────────────────────────────────────────────────────
# Пусто (или нет переменной) → локальный SQLite, файл data/diet.db
#   (без сервера, для разработки и ноутбуков).
# URL PostgreSQL (managed, РФ-провайдер) → продакшен-режим через psycopg:
#   pip install "psycopg[binary]"
# DIET_DB_URL=postgresql://user:password@host:5432/dbname
DIET_DB_URL=

# ─── JWT (аутентификация, D4) ──────────────────────────────────────────────
# Секрет для подписи access-токенов (HS256). Сгенерируйте длинную случайную
# строку, например:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Без переменной используется случайный ephemeral ключ — токены инвалидируются
# при каждом рестарте процесса (только для локальной разработки).
DIET_JWT_SECRET=замените_на_длинную_случайную_строку_минимум_32_байта

